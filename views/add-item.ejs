<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <title>Add item</title>
</head>

<body>
    <nav>
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo">CRUD</a>
            <ul id="nav-mobile" class="right hide-on-med-and-down">
                <li><a href="add-item.html">Add item</a></li>

            </ul>
        </div>
    </nav>
    <div class="container">
        <div class="row">
            <form class="col s12">
                <div class="row">
                    <div class="input-field col s6">
                        <i class="material-icons prefix">shopping_cart</i>
                        <input id="item_name" type="text" class="validate">
                        <label for="item_name">Item Name</label>
                    </div>
                    <div class="input-field col s6">
                        <i class="material-icons prefix">request_quote</i>
                        <input id="icon_telephone" type="tel" class="validate" name="price">
                        <label for="icon_telephone">Price</label>
                    </div>
                    <button class="btn">Add item</button>
                </div>
            </form>
        </div>
    </div>
</body>

</html>